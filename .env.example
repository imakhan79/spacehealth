# Copy-free setup: `node scripts/generate-secrets.ts` fills the secrets below
# into .env. Never commit .env.

# --- Secrets (generated) -------------------------------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
OMNI_RELAY_PASSWORD=
# Shared HMAC secret for the Earth uplink. The same value goes into Mission
# Control's UPLINK_SECRETS as {"<OMNI_SPACECRAFT_ID>": "<this value>"}.
OMNI_UPLINK_SECRET=

# --- Network ------------------------------------------------------------------
# Hostname crew devices use on the spacecraft LAN. Must match a SAN in the TLS
# cert (scripts/generate-certs.sh).
OMNI_SITE_URL=https://omni.local:8443
OMNI_BIND_ADDR=0.0.0.0
OMNI_HTTPS_PORT=8443
OMNI_HTTP_PORT=8080
OMNI_ADMIN_PORT=8000

# --- Earth uplink (Phase 3) -----------------------------------------------------
OMNI_SPACECRAFT_ID=omni-1
# Mission Control base URL, no trailing slash.
OMNI_UPLINK_URL=
OMNI_UPLINK_MAX_BATCH_ENTRIES=500
OMNI_UPLINK_MAX_BATCH_BYTES=1000000

# --- Storage ------------------------------------------------------------------
OMNI_DATA_DIR=./data
OMNI_TLS_DIR=./data/tls

# --- Auth -----------------------------------------------------------------------
JWT_EXPIRY=3600

# --- Resource limits (tune to flight hardware) -----------------------------------
OMNI_DB_MEM_LIMIT=768m
OMNI_DB_CPUS=1.0
OMNI_PG_SHARED_BUFFERS=160MB
OMNI_PG_EFFECTIVE_CACHE=448MB
OMNI_AUTH_MEM_LIMIT=128m
OMNI_REST_MEM_LIMIT=128m
OMNI_REALTIME_MEM_LIMIT=384m
OMNI_WEB_MEM_LIMIT=384m

OMNI_VERSION=dev
