# Rendered at container start by the nginx image's envsubst step, filtered to
# ANON_KEY, SERVICE_ROLE_KEY and OMNI_HTTPS_PORT. Every other $name below is an
# nginx variable.

# Docker's embedded DNS. Upstreams are resolved per request (proxy_pass with a
# variable), so the gateway boots and keeps serving even while a backend
# container is down or restarting: that one route returns 502, the rest work.
resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 2s;

server_tokens off;
client_max_body_size 2m;

# supabase-js sends the key as an `apikey` header; the realtime websocket
# sends it as a query parameter.
map $http_apikey $omni_apikey {
    ""      $arg_apikey;
    default $http_apikey;
}

# Same behaviour as Supabase's gateway: with no user session, the request
# authenticates as the API key's own role.
map $http_authorization $omni_authorization {
    ""      "Bearer $omni_apikey";
    default $http_authorization;
}

map $http_upgrade $omni_connection_upgrade {
    default upgrade;
    ""      close;
}

# --- Crew LAN, plain HTTP: redirect only --------------------------------------
server {
    listen 8080;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 308 https://$host:${OMNI_HTTPS_PORT}$request_uri;
    }
}

# --- Crew LAN, HTTPS: app + API. Anon key only. -------------------------------
server {
    listen 8443 ssl;
    http2 on;

    ssl_certificate     /etc/omni/tls/server.crt;
    ssl_certificate_key /etc/omni/tls/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:omni_tls:1m;
    ssl_session_timeout 1d;

    # The service_role key is never honoured from the LAN, even if leaked.
    set $omni_key_ok 0;
    if ($omni_apikey = "${ANON_KEY}") {
        set $omni_key_ok 1;
    }

    include /etc/nginx/omni/api-routes.conf;

    location / {
        set $omni_upstream web:3000;
        proxy_pass http://$omni_upstream;
        include /etc/nginx/omni/proxy-common.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $omni_connection_upgrade;

        proxy_intercept_errors on;
        error_page 502 503 504 = @web_unavailable;
    }

    # Never show the crew a blank screen or a raw nginx error.
    location @web_unavailable {
        default_type text/html;
        add_header Retry-After 5 always;
        add_header Cache-Control "no-store" always;
        return 503 '<!doctype html><html><head><meta charset="utf-8"><meta http-equiv="refresh" content="5"><title>OMNI restarting</title></head><body style="font-family:system-ui,sans-serif;background:#0b0f14;color:#e6edf3;padding:2rem"><h1>OMNI interface is restarting</h1><p>Health monitoring and data capture continue on the spacecraft server. This page retries every 5 seconds.</p></body></html>';
    }
}

# --- Internal + host-loopback admin API. Anon or service_role key. ------------
# Reached by the web container (server-side calls) and, via 127.0.0.1 only,
# by crew-provisioning scripts on the host.
server {
    listen 8000;

    # Next.js server actions forward the crew device's address so GoTrue
    # rate-limits per device. Only trusted from private (Docker) ranges.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Real-IP;

    set $omni_key_ok 0;
    if ($omni_apikey = "${ANON_KEY}") {
        set $omni_key_ok 1;
    }
    if ($omni_apikey = "${SERVICE_ROLE_KEY}") {
        set $omni_key_ok 1;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    include /etc/nginx/omni/api-routes.conf;
}
